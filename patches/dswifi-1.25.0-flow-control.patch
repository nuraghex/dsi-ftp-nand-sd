+// HTC credit flow control
+// =======================
+//
+// The target has a fixed number of TX buffers ("credits"). It says how many
+// there are, and their size, in HTC_MSG_READY, and it reports the ones it has
+// freed in the trailer of the packets it sends to the host. Sending a packet
+// when there are no credits left overflows the mailbox of the target, so the
+// packets that come from the ARM9 wait in the TX queue until there are credits.
+
+#define HTC_HDR_SIZE        6
+#define HTC_CRED_RESERVE    1 // Credits that data never uses: kept for WMI
+#define HTC_CRED_STALL_MAX  4 // Frames without credits before sending anyway
+
+static u16 htc_cred_total = 0;
+static u16 htc_cred_size = 0; // 0 = not known yet: no flow control
+static s32 htc_cred_avail = 0;
+static u32 htc_cred_stall_frames = 0;
+static u32 htc_cred_last_line = 0;
+static u32 htc_cred_stat_defer = 0;
+static u32 htc_cred_stat_force = 0;
+
+void wifi_card_htc_credits_init(u16 count, u16 size)
+{
+    // With too few credits the reserve would never let data through
+    if (count < 4 || size < 256)
+    {
+        htc_cred_size = 0;
+        return;
+    }
+
+    htc_cred_total = count;
+    htc_cred_size = size;
+    htc_cred_avail = count;
+    htc_cred_stall_frames = 0;
+}
+
+static s32 htc_credits_for(u32 len)
+{
+    return (len + HTC_HDR_SIZE + htc_cred_size - 1) / htc_cred_size;
+}
+
+static void htc_credits_consume(u32 len)
+{
+    if (htc_cred_size == 0)
+        return;
+
+    htc_cred_avail -= htc_credits_for(len);
+    if (htc_cred_avail < 0)
+        htc_cred_avail = 0;
+}
+
+static void htc_credits_return(u32 count)
+{
+    if (htc_cred_size == 0)
+        return;
+
+    htc_cred_avail += count;
+    if (htc_cred_avail > htc_cred_total)
+        htc_cred_avail = htc_cred_total;
+
+    htc_cred_stall_frames = 0;
+}
+
+// True if the packet that follows a data packet of this size would have to
+// wait: the target is then asked to report its free credits right away.
+static bool htc_credits_low(u32 len)
+{
+    if (htc_cred_size == 0)
+        return false;
+
+    return htc_cred_avail < (2 * htc_credits_for(len) + HTC_CRED_RESERVE);
+}
+
+// Returns true if a data packet of this size can be sent now.
+bool wifi_card_tx_credits_ok(u32 len)
+{
+    if (htc_cred_size == 0)
+        return true;
+
+    if (htc_cred_avail >= (htc_credits_for(len) + HTC_CRED_RESERVE))
+    {
+        htc_cred_stall_frames = 0;
+        return true;
+    }
+
+    // Count the frames spent waiting. This is called at least once per frame,
+    // from the VBL handler, always in the same line: the same line or an
+    // earlier one than the last time means that a new frame has started.
+    u32 line = REG_VCOUNT;
+    if (line <= htc_cred_last_line)
+        htc_cred_stall_frames++;
+    htc_cred_last_line = line;
+
+    // If the count of credits is ever wrong (a lost report, for example) the
+    // queue must not stay blocked forever. Send one packet anyway, like the
+    // driver did before it counted credits.
+    if (htc_cred_stall_frames >= HTC_CRED_STALL_MAX)
+    {
+        htc_cred_stall_frames = 0;
+        htc_cred_stat_force++;
+        if ((htc_cred_stat_force & (htc_cred_stat_force - 1)) == 0)
+        {
+            WLOG_PRINTF("T: TX forced, no credits (%u)\n",
+                        (unsigned int)htc_cred_stat_force);
+            WLOG_FLUSH();
+        }
+        return true;
+    }
+
+    htc_cred_stat_defer++;
+    if ((htc_cred_stat_defer & (htc_cred_stat_defer - 1)) == 0)
+    {
+        WLOG_PRINTF("T: TX waits for credits (%u)\n",
+                    (unsigned int)htc_cred_stat_defer);
+        WLOG_FLUSH();
+    }
+    return false;
+}
+
